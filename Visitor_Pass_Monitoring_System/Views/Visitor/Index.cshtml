@model IEnumerable<Visitor_Pass_Monitoring_System.Models.Visitor>

<div class="card shadow-sm border-0 mt-4">
    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center py-3">
        <h4 class="mb-0">Visitor Monitoring List</h4>
        <a asp-action="Create" class="btn btn-outline-light btn-sm">+ Register New Visitor</a>
    </div>
    <div class="card-body bg-white">

        <form asp-action="Index" method="get" class="mb-4 row g-2">
            <div class="col-md-4">
                <input type="text" name="searchString" placeholder="Search Pass No." class="form-control" />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-secondary w-100">Search</button>
            </div>
        </form>

        <div class="table-responsive">
            <table class="table table-hover align-middle border">
                <thead class="table-dark">
                    <tr>
                        <th>Pass Number</th>
                        <th>Name</th>
                        <th>Company</th>
                        <th>Person To Visit</th>
                        <th>Entry Time</th>
                        <th>Exit Time</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="fw-bold text-dark">@item.PassNumber</td>
                            <td>@item.FirstName @item.LastName</td>
                            <td>@item.Company</td>
                            <td>@item.PersonToVisit</td>
                            <td>@item.EntryDateTime</td>
                            <td>@(item.ExitDateTime.HasValue ? item.ExitDateTime.Value.ToString() : "-")</td>
                            <td>
                                @if (item.Status == "Inside Building")
                                {
                                    <span class="badge bg-warning text-dark">Inside Building</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary">Left Building</span>
                                }
                            </td>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark">Details</a>
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary">Edit</a>
                                @if (item.Status == "Inside Building")
                                {
                                    <a asp-action="Exit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Exit</a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>